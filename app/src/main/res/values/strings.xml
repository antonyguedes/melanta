    <!-- Onboarding de permissões -->
    <string name="onboarding_title">Permissões</string>
    <string name="onboarding_intro">O Melanta roda um modelo de IA no próprio aparelho e opera outros apps por você. Para isso, ele precisa das permissões abaixo. Nada da sua tela sai do celular.</string>
    <string name="onboarding_continue">Continuar</string>
    <string name="permission_required">Obrigatória</string>
    <string name="permission_recommended">Recomendada</string>
    <string name="permission_optional">Opcional</string>
    <string name="permission_granted">Concedida</string>
    <string name="permission_denied">Não concedida</string>
    <string name="permission_open_settings">Abrir configurações</string>
    <string name="permission_allow">Permitir</string>

    <string name="permission_accessibility_title">Acessibilidade</string>
    <string name="permission_accessibility_body">Permite ler a tela e tocar, digitar e rolar em outros apps. O agente só age depois que você inicia uma tarefa.</string>
    <string name="permission_accessibility_waiting">Ativada, aguardando o sistema conectar o serviço…</string>

    <string name="permission_restricted_title">Configuração restrita bloqueada?</string>
    <string name="permission_restricted_body">No Android 13 ou superior, apps instalados fora da loja não podem ativar Acessibilidade de primeira. Se a opção aparecer desativada: abra a tela do app, toque no menu ⋮ e escolha \"Permitir configurações restritas\". Depois volte e ative a Acessibilidade.</string>
    <string name="permission_restricted_action">Abrir informações do app</string>

    <string name="permission_notifications_title">Notificações</string>
    <string name="permission_notifications_body">Mostra a notificação persistente com o botão PARAR enquanto o agente trabalha e o progresso do download do modelo.</string>

    <string name="permission_listener_title">Leitor de notificações</string>
    <string name="permission_listener_body">Dá ao agente o contexto das notificações recentes (por exemplo, a última mensagem recebida).</string>

    <string name="permission_contacts_title">Contatos</string>
    <string name="permission_contacts_body">Permite ligar e mandar mensagens pelo nome (\"liga para a Ana\"). Os contatos são lidos só no aparelho.</string>
    <string name="permission_overlay_title">Sobreposição a outros apps</string>
    <string name="permission_overlay_body">Reserva para o botão flutuante de parada quando a Acessibilidade estiver desligada.</string>

