<?xml version="1.0" encoding="utf-8"?>
<!-- Só no build de debug. DUMP é uma permissão do shell (adb): nenhum app comum consegue enviar. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name="com.melanta.debug.AutomationDebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.melanta.debug.DUMP" />
                <action android:name="com.melanta.debug.EXEC" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
